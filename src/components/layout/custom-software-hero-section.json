{
  "collectionName": "components_layout_custom_software_hero_sections",
  "info": {
    "displayName": "Custom Software Hero Section",
    "description": "Dark two-column hero: tag, heading, description, checklist and review ratings on the left; featured image and HubSpot consultation form on the right."
  },
  "options": {},
  "attributes": {
    "tag": {
      "type": "component",
      "repeatable": false,
      "component": "elements.badge"
    },
    "heading": {
      "type": "blocks"
    },
    "description": {
      "type": "blocks"
    },
    "checklist": {
      "type": "component",
      "repeatable": true,
      "component": "elements.checklist-item"
    },
    "clutchWidget": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::clutch-widget.clutch-widget"
    },
    "goodfirmsWidget": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::goodfirms-widget.goodfirms-widget"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "hubspotForm": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hub-spot-form.hub-spot-form"
    },
    "backgroundPattern": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "paddingTop": {
      "type": "integer",
      "min": 0
    },
    "paddingBottom": {
      "type": "integer",
      "min": 0
    },
    "marginTop": {
      "type": "integer",
      "min": 0
    },
    "marginBottom": {
      "type": "integer",
      "min": 0
    }
  }
}
