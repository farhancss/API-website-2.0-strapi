{
  "collectionName": "components_layout_design_technologies_sections",
  "info": {
    "displayName": "Design Technologies Section",
    "description": "Centered heading and description with a row of design tool icons. Switch backgroundTheme to dark for the dark band treatment."
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "blocks"
    },
    "description": {
      "type": "text"
    },
    "technologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::technology.technology"
    },
    "backgroundTheme": {
      "type": "enumeration",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "paddingTop": {
      "type": "integer",
      "min": 0
    },
    "paddingBottom": {
      "type": "integer",
      "min": 0
    },
    "marginTop": {
      "type": "integer",
      "min": 0
    },
    "marginBottom": {
      "type": "integer",
      "min": 0
    }
  }
}
